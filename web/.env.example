# Web workspace environment (server-side only)
# Copy to .env and fill in real values. NEVER commit real values (see audit:token).

# The gateway's base URL (your running cmd/gateway on :8080)
GATEWAY_URL=http://localhost:8080

# The gateway's GATEWAY_API_TOKEN value — server-side only. NEVER use NEXT_PUBLIC_*.
GATEWAY_TOKEN=replace-me-placeholder